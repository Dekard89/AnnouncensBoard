name: dockercompose8253762945364098494
services:
  announcensboard:
    build:
      context: C:\Users\dmitr\source\repos\announcenscard
      dockerfile: AnnouncensBoard/Dockerfile
    depends_on:
      database:
        condition: service_started
        required: true
      redis:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      WAIT_HOSTS: database:5432, redis:6379
    image: announcensboard
    networks:
      asp-network: null
    ports:
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\dmitr\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\dmitr\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
  database:
    container_name: postgres
    environment:
      POSTGRES_DB: my_db
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres
    networks:
      asp-network: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: postgres-data
        target: /var/lib/postgres/data
        volume: {}
  redis:
    container_name: redis
    environment:
      REDIS_DATABASES: "16"
      REDIS_PASSWORD: my-password
      REDIS_PORT: "6379"
    image: redis:latest
    networks:
      asp-network: null
    ports:
      - mode: ingress
        target: 6379
        published: "6379"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: redis
        target: /data
        volume: {}
networks:
  asp-network:
    name: dockercompose8253762945364098494_asp-network
    driver: bridge
volumes:
  postgres-data:
    name: dockercompose8253762945364098494_postgres-data
  redis:
    name: dockercompose8253762945364098494_redis